<Project>
  <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>    
    <Company>Sphere</Company>
    <Trademark>Sphere</Trademark>
    <Copyright>All right reserved</Copyright>
    <Version>0.4.4</Version>
    <AssemblyVersion>0.0.8.2</AssemblyVersion>
    <FileVersion>0.0.8.2</FileVersion>
    
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="License" Value="MIT License(https://mit-license.org/)" />
    <AssemblyMetadata Include="MoreInfo" Value="https://github.com/shiljopaulson" />
    <AssemblyMetadata Include="Contributors" Value="Shiljo Paulson" />
  </ItemGroup>
</Project>
